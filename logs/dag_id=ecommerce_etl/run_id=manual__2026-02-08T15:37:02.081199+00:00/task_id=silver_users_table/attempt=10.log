[2026-02-08T16:54:57.508+0000] {bigquery.py:2807} INFO - Executing: {'query': {'query': "-- silver_users.sql (IDEMPOTENT + PARTITIONED)\nMERGE `prism-486509.silver.users` AS target\nUSING (\n  WITH deduplicated_users AS (\n    SELECT\n      *,\n      ROW_NUMBER() OVER (\n        PARTITION BY id\n        ORDER BY SAFE_CAST(created_at AS TIMESTAMP) DESC\n      ) AS row_num\n    FROM `prism-486509.bronze.users`\n    WHERE id IS NOT NULL\n  )\n  SELECT\n    -- Identifiers\n    SAFE_CAST(id AS INT64) AS user_id,\n\n    -- Name formatting\n    CONCAT(first_name, ' ', last_name) AS full_name,\n    LOWER(email) AS email_address,\n\n    -- Demographics\n    SAFE_CAST(age AS INT64) AS age,\n    CASE \n      WHEN SAFE_CAST(age AS INT64) < 18 THEN 'Under 18'\n      WHEN SAFE_CAST(age AS INT64) BETWEEN 18 AND 34 THEN '18-34'\n      WHEN SAFE_CAST(age AS INT64) BETWEEN 35 AND 54 THEN '35-54'\n      ELSE '55+'\n    END AS age_group,\n    COALESCE(gender, 'Not Specified') AS gender,\n\n    -- Address\n    COALESCE(city, 'Unknown City') AS city,\n    COALESCE(state, 'Unknown State') AS state,\n    country,\n    COALESCE(postal_code, 'N/A') AS zip_code,\n    COALESCE(street_address, 'UNKNOWN') AS street_address,\n    COALESCE(SAFE_CAST(latitude AS BIGNUMERIC), 0.0) AS latitude,\n    COALESCE(SAFE_CAST(longitude AS BIGNUMERIC), 0.0) AS longitude,\n\n    -- Metadata\n    traffic_source,\n    SAFE_CAST(created_at AS TIMESTAMP) AS signup_timestamp,\n    CURRENT_TIMESTAMP() AS ingestion_ts,\n\n    -- Data quality\n    REGEXP_CONTAINS(email, r'@.+\\..+') AS is_valid_email_format,\n\n    -- ✅ PARTITION KEY\n    @run_date AS ingestion_date\n\n  FROM deduplicated_users\n  WHERE row_num = 1\n) AS source\n\nON target.user_id = source.user_id \n   AND target.ingestion_date = @run_date  -- ✅ Partition filter\n\nWHEN MATCHED THEN \n  UPDATE SET\n    full_name = source.full_name,\n    email_address = source.email_address,\n    age = source.age,\n    age_group = source.age_group,\n    gender = source.gender,\n    city = source.city,\n    state = source.state,\n    country = source.country,\n    zip_code = source.zip_code,\n    street_address = source.street_address,\n    latitude = source.latitude,\n    longitude = source.longitude,\n    traffic_source = source.traffic_source,\n    signup_timestamp = source.signup_timestamp,\n    ingestion_ts = source.ingestion_ts,\n    is_valid_email_format = source.is_valid_email_format\n\nWHEN NOT MATCHED THEN\n  INSERT (\n    user_id, full_name, email_address, age, age_group, gender,\n    city, state, country, zip_code, street_address, latitude, longitude,\n    traffic_source, signup_timestamp, ingestion_ts, is_valid_email_format,\n    ingestion_date\n  )\n  VALUES (\n    source.user_id, source.full_name, source.email_address, source.age, \n    source.age_group, source.gender, source.city, source.state, source.country,\n    source.zip_code, source.street_address, source.latitude, source.longitude,\n    source.traffic_source, source.signup_timestamp, source.ingestion_ts,\n    source.is_valid_email_format, source.ingestion_date\n  );", 'useLegacySql': False, 'writeDisposition': 'WRITE_TRUNCATE', 'queryParameters': [{'name': 'run_date', 'parameterType': {'type': 'DATE'}, 'parameterValue': {'value': '2026-02-08'}}]}}'
