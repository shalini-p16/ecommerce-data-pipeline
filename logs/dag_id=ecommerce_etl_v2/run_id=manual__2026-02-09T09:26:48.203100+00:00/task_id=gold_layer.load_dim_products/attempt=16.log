ts` AS source\nINNER JOIN `prism-486509.gold.dim_products` AS target\n  ON target.id = source.id\nWHERE target.effective_to = CURRENT_DATE()\n  AND target.is_current = FALSE;", 'useLegacySql': False, 'queryParameters': [{'name': 'run_date', 'parameterType': {'type': 'DATE'}, 'parameterValue': {'value': '2026-02-09'}}]}}'
